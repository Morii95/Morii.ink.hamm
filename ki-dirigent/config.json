{
  "server": {
    "host": "127.0.0.1",
    "port": 8765,
    "erlaubte_hosts": ["localhost", "127.0.0.1", "::1"]
  },

  "ollama": {
    "url": "http://localhost:11434",
    "router_modell": "qwen2.5:7b",
    "helfer_modell": "qwen2.5:7b",
    "embedding_modell": "nomic-embed-text",
    "num_ctx": 8192,
    "keep_alive": "30m",
    "autostart": true,
    "programm": ""
  },

  "programme": {
    "installationsordner": "",
    "pfade": [],
    "automatisch_suchen": true
  },

  "anthropic": { "base_url": "https://api.anthropic.com" },
  "openai":    { "base_url": "https://api.openai.com/v1" },
  "gemini":    { "base_url": "https://generativelanguage.googleapis.com/v1beta" },

  "arbeitsplatz": "arbeitsplatz",
  "daten": "daten",

  "ki_ordner": {
    "anthropic": { "ordner": "claude",  "tool_ordner": "~/.claude",  "tool_anweisungen": "CLAUDE.md" },
    "openai":    { "ordner": "chatgpt", "tool_ordner": "~/.codex",   "tool_anweisungen": "AGENTS.md" },
    "gemini":    { "ordner": "gemini",  "tool_ordner": "~/.gemini",  "tool_anweisungen": "GEMINI.md" },
    "ollama":    { "ordner": "ollama",  "tool_ordner": "~/.ollama",  "tool_anweisungen": "" },
    "tool_anweisungen_nutzen": false,
    "max_zeichen": 2000
  },

  "pc": {
    "lesen": ["*"],
    "schreiben": [],
    "sperren": [".ssh", ".gnupg", ".aws", ".azure", ".kube", ".docker", ".password-store",
                "*.pem", "*.key", "*.p12", "*.pfx", "*.kdbx", "id_rsa*", "id_ed25519*", ".env", ".env.*",
                "Login Data", "Cookies", "Web Data", "*.keychain*", "wallet.dat"],
    "scan_ueberspringen": [".git", "node_modules", "__pycache__", ".venv", "venv", ".cache", ".npm",
                           "AppData", "$Recycle.Bin", "System Volume Information", "Windows",
                           "Program Files", "Program Files (x86)", "ProgramData", "Library",
                           "proc", "sys", "dev", "snap"],
    "scan_max_eintraege": 200000,
    "analyse_max_dateien": 300,
    "bereitstellen_max_mb": 200
  },

  "sparen": {
    "strategie": "sparsam",
    "zerlegen": true,
    "max_teilaufgaben": 4,
    "cache": true,
    "verlauf_letzte": 4,
    "verdichten_ab_zeichen": 6000,
    "max_nachricht_zeichen": 6000,
    "max_datei_zeichen": 60000,
    "vorbereiten_ab_zeichen": 12000,
    "vorbereiten_bis_zeichen": 250000,
    "zusammenfuehren_lokal_bis_zeichen": 8000,
    "weg_in_kompat_antwort": true
  },

  "system_basis": "Antworte in der Sprache des Nutzers. Sei präzise und komme direkt zum Punkt, ohne Einleitungs- oder Füllsätze.",

  "spezialisten": [
    {
      "id": "lokal",
      "name": "Ollama Allrounder",
      "anbieter": "ollama",
      "modell": "qwen2.5:7b",
      "kategorien": ["chat", "text", "uebersetzung", "analyse", "kreativ"],
      "niveau": 1,
      "kosten": 0,
      "max_tokens": 2048,
      "max_kontext_zeichen": 20000,
      "staerken": "Smalltalk, kurze Fragen, Umformulieren, kurze Texte zusammenfassen oder übersetzen"
    },

    {
      "id": "lokal-code",
      "name": "Ollama Coder",
