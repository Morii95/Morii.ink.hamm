      "name": "Claude Haiku (Claude Code)",
      "anbieter": "cli",
      "familie": "anthropic",
      "modell": "haiku",
      "aktiv": "auto",
      "befehl": ["claude", "-p", "--model", "haiku", "--output-format", "json"],
      "ausgabe": { "format": "json", "text": "result", "ein": "usage.input_tokens", "aus": "usage.output_tokens" },
      "env_entfernen": ["ANTHROPIC_API_KEY"],
      "kategorien": ["alles"],
